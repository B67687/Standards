# check-parity.sh configuration for standards
# Source of truth for what this repo verifies locally vs. on GitHub CI.
# See scripts/check-parity.sh for semantics.

# Dev repo where GitHub CI runs (four-layer model: local -> Dev -> public)
REPO_SLUG=B67687/Standards-Dev

# Workflow names that carry the migrated checks (space-separated)
WORKFLOWS=CI

# Command that runs ALL migrated checks locally. Exit 0 == pass.
# MUST be quoted: unquoted 'VAR=a b' sources as running command 'b' with
# env VAR=a (classic sourced-config pitfall).
LOCAL_CMD="make check"

# Expected results for parity to hold
EXPECT_LOCAL=pass
EXPECT_REMOTE=success
